{
  "name": "oddlink-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:up": "pnpm --filter web db:up",
    "db:down": "pnpm --filter web db:down",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:studio": "pnpm --filter web db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.15.0"
}
