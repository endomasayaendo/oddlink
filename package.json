{
  "name": "oddlink-monorepo",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "stop": "node scripts/stop.mjs",
    "verify": "node scripts/verify.mjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "pnpm --filter web start",
    "lint": "turbo lint lint:scripts",
    "lint:scripts": "eslint --max-warnings 0 scripts",
    "test": "turbo test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "turbo typecheck",
    "db:up": "pnpm --filter web db:up",
    "db:down": "pnpm --filter web db:down",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:studio": "pnpm --filter web db:studio"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.15.0"
}
