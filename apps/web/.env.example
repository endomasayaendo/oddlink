# Docker Compose (apps/web/docker-compose.yml)
DB_NAME=oddlink
DB_USERNAME=postgres
DB_PASSWORD=postgres

# App. BASE_URL and DATABASE_URL are required in production; dev falls back to the defaults below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oddlink
BASE_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Tokyo

# Google Safe Browsing API key. Required in production (the server refuses to start without it);
# in dev the check is skipped with a warning when it is empty. Restrict the key to the Safe Browsing API.
SAFE_BROWSING_API_KEY=

# Per-client rate limit on issuing links. All three are required in production; dev and tests
# fall back to dev-only defaults when they are empty. Set real values only in the deploy
# environment, never in the repository. RATE_LIMIT_SECRET: a random string of 32+ characters
# (e.g. `openssl rand -hex 32`).
RATE_LIMIT_SECRET=
ISSUE_RATE_LIMIT_MAX=
ISSUE_RATE_LIMIT_WINDOW_SECONDS=

# Tests only (pnpm test); the app itself never reads it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/oddlink_test
