# Docker Compose (apps/web/docker-compose.yml)
DB_NAME=oddlink
DB_USERNAME=postgres
DB_PASSWORD=postgres

# App. BASE_URL, DATABASE_URL and LINK_SIGNING_SECRET are required in production; dev falls back to defaults.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oddlink
BASE_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Tokyo
# Signs reroll tokens; at least 32 characters. Leave empty in dev to use a built-in dev key.
# In production generate a random one, e.g. `openssl rand -base64 32`, and keep it secret.
LINK_SIGNING_SECRET=

# Tests only (pnpm test); the app itself never reads it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/oddlink_test
